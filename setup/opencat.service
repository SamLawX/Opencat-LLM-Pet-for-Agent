[Unit]
Description=OpenCat Backend Service
After=network.target

[Service]
Type=simple
User=root
# Change WorkingDirectory to your actual Opencat location
WorkingDirectory=/opt/opencat/backend
# If using a virtual environment, update the python path (e.g., /opt/opencat/.venv/bin/python)
ExecStart=/usr/bin/python3 /opt/opencat/backend/main.py --host 0.0.0.0 --port 9999
Restart=always
RestartSec=5
StandardOutput=append:/opt/opencat/backend/service.log
StandardError=append:/opt/opencat/backend/service.log

[Install]
WantedBy=multi-user.target
